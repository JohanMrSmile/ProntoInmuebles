# Pronto Inmuebles Home - Variables de Entorno

# ========================================
# SUPABASE (Base de datos y autenticación)
# ========================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ========================================
# SECURITY
# ========================================
ALLOWED_ORIGIN=https://prontoinmuebleshome.com

# ========================================
# SANITY CMS
# ========================================
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=your_sanity_read_token

# ========================================
# WHATSAPP BUSINESS API
# ========================================
WHATSAPP_PHONE_NUMBER=573001234567
WHATSAPP_BUSINESS_ID=your_business_id
WHATSAPP_ACCESS_TOKEN=your_access_token

# ========================================
# n8n AUTOMATION
# ========================================
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/lead

# ========================================
# GOOGLE ANALYTICS
# ========================================
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ========================================
# GOOGLE TAG MANAGER
# ========================================
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ========================================
# CALENDLY
# ========================================
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/prontoinmuebles/asesoria

# ========================================
# META PIXEL (Facebook)
# ========================================
NEXT_PUBLIC_META_PIXEL_ID=your_pixel_id

# ========================================
# CONTACT INFO
# ========================================
NEXT_PUBLIC_PHONE=+573001234567
NEXT_PUBLIC_EMAIL=info@prontoinmuebleshome.com
NEXT_PUBLIC_ADDRESS=Centro Comercial Plaza Mayor, Local 234
NEXT_PUBLIC_WHATSAPP=573001234567

# ========================================
# SOCIAL MEDIA
